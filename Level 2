function drawAlleyFight(dt){
  drawAlleyBG();
  // update player
  if(!charDead){
    if(keys['KeyA']||keys['ArrowLeft']){P.vx=-2.5;P.facing=-1;}
    else if(keys['KeyD']||keys['ArrowRight']){P.vx=2.5;P.facing=1;}
    else P.vx*=0.7;
    if(keys['KeyW']||keys['ArrowUp']){if(P.onGround){P.vy=-8;P.onGround=false;}}
    P.x=Math.max(10,Math.min(W-40,P.x+P.vx));
    P.vy+=0.5;P.y+=P.vy;
    if(P.y>=320){P.y=320;P.vy=0;P.onGround=true;}
    if(Math.abs(P.vx)>0.3){P.frameTimer+=dt;if(P.frameTimer>6){P.frame=(P.frame+1)%4;P.frameTimer=0;}}
  }

  // gang members move + shoot
  let allDead=true;
  gangMembers.forEach(g=>{
    if(g.dead)return;
    allDead=false;
    // move towards player slowly
    g.moveTimer+=dt;
    if(g.moveTimer>12){
      const dx=P.x-g.x;
      g.x+=Math.sign(dx)*0.6;
      g.moveTimer=0;
    }
    g.frameTimer+=dt;if(g.frameTimer>10){g.frame=(g.frame+1)%2;g.frameTimer=0;}
    // shoot
    g.shootTimer-=dt;
    if(g.shootTimer<=0){
      g.shootTimer=80+Math.random()*60;
      const dx=P.x-g.x;
      enemyBullets.push({x:g.x,y:g.y+20,vx:Math.sign(dx)*5,vy:0});
    }
    drawBigGuy(g.x,g.y,'#5C2D0E','',1,true,false);
    // gun
    ctx.fillStyle='#333';
    ctx.fillRect(px(g.x+10),px(g.y+20),20,8);
  });

  // draw player
  drawPixelChar(P.x,P.y,'#ffcc99','#2244aa',P.facing,P.frame);
  // gun in hand
  ctx.fillStyle='#555';
  ctx.fillRect(px(P.x+(P.facing>0?22:0)),px(P.y+14),18,8);

  // update bullets
  bullets=bullets.filter(b=>{
    b.x+=b.vx;b.y+=b.vy;
    drawBullet(b.x,b.y,Math.sign(b.vx));
    if(b.x<0||b.x>W)return false;
    // hit gang
    let hit=false;
    gangMembers.forEach(g=>{
      if(g.dead)return;
      if(Math.abs(b.x-g.x)<35&&Math.abs(b.y-g.y)<50){
        g.hp--;spawnParticle(b.x,b.y,'#ff4444');
        if(g.hp<=0){g.dead=true;updateAura(75,'eliminated bro');}
        hit=true;
      }
    });
    return !hit;
  });
  enemyBullets=enemyBullets.filter(b=>{
    b.x+=b.vx;
    drawBullet(b.x,b.y,Math.sign(b.vx),'#ff4444');
    if(b.x<0||b.x>W)return false;
    if(!charDead&&Math.abs(b.x-P.x)<20&&Math.abs(b.y-(P.y+20))<30){
      playerHits++;setHP(8-playerHits);
      spawnParticle(P.x+14,P.y+20,'#ff8800');
      updateAura(-30,'got shot');
      if(playerHits>=8){
        charDead=true;
        setTimeout(()=>{gameState='died_fight';clearOverlay();showOverlay(`
          <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;">
            <div style="font-family:'Press Start 2P';font-size:20px;color:#FF0000;margin-bottom:20px;">YOU DIED</div>
            <button class="btn btn-red" onclick="respawnFight()">RESPAWN</button>
          </div>
        `);},800);
      }
      return false;
    }
    return true;
  });

  updateParticles();drawParticles();

  if(allDead&&!charDead){
    gameState='giant_appears';
    charDead=true;
    clearOverlay();
    bigDudeX=-150;uppercut=false;uppercutTimer=0;charY=0;charYVel=0;
    updateAura(-200,'got upper cut into orbit');
  }
}

