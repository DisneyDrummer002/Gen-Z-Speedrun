  ctx.fillStyle='rgba(0,0,0,0.6)';
  ctx.fillRect(8,420,300,30);
  ctx.font="5px 'Press Start 2P'";ctx.fillStyle='#888';
  ctx.fillText('WASD=MOVE  E=PUNCH  R=KICK  Q=TRASH TALK',12,438);

  // stall door button
  if(lanceDead&&P.x>200&&P.x<360&&P.y>200&&P.y<380){
    showOverlay(`
      <div style="position:absolute;bottom:80px;left:50%;transform:translateX(-50%);">
        <button class="btn btn-cyan" onclick="obtainSkibidiToilet()">OBTAIN SKIBIDI TOILET</button>
      </div>
    `);
  } else if(!lanceDead) {
    clearOverlay();
  }

  updateParticles();drawParticles();
}

function drawLanceCries(dt){
  drawBathroomBG();
  lanceCrying=true;
  drawBigGuy(lanceX,lanceY-60,'#cc9966','LANCE',1.4,false,false,true);
  drawPixelChar(P.x,P.y,'#ffcc99','#2244aa',P.facing,P.frame);
}

function obtainSkibidiToilet(){
  clearOverlay();
  updateAura(300,'obtained skibidi toilet');
  gameState='boss_final';
  setTimeout(()=>{
    showOverlay(`
      <div class="textbox" style="bottom:20px;">
        <div class="speaker">BOSS</div>
        Good job buddy, you will fit in here pretty darn good
      </div>
    `,false);
    setTimeout(()=>{
      showOverlay(`
        <div class="textbox" style="bottom:20px;">
          <div class="speaker">BOSS</div>
          Good job buddy, you will fit in here pretty darn good
          <div style="text-align:center;margin-top:16px;">
            <button class="btn btn-green" onclick="goEnding()">NEXT</button>
          </div>
        </div>
      `);
    },5000);
  },500);
}

function drawBossFinal(){
  ctx.fillStyle='#050510';
  ctx.fillRect(0,0,W,H);
  drawDialogueSide();
  drawBigGuy(580,100,'#5C2D0E','BOSS',1.6,true,true);
  drawPixelChar(120,180,'#ffcc99','#2244aa',1,0);
  drawText('YOU',W/4,30,7,'#00FF00','center');
  drawText('BOSS',3*W/4,30,7,'#FF9900','center');
}

function goEnding(){
  clearOverlay();
  updateAura(500,'COMPLETED THE MISSION');
  gameState='ending';
}

function drawEnding(){
  ctx.fillStyle='#050510';
  ctx.fillRect(0,0,W,H);
  // stars
  for(let i=0;i<60;i++){
    ctx.fillStyle='#fff';
    ctx.fillRect((i*197)%W,(i*113)%H,1+(i%4===0?1:0),1+(i%4===0?1:0));
  }
  // confetti
  for(let i=0;i<20;i++){
    const cx=(i*137+animTimer*2)%W;
    const cy=((i*97+animTimer)%H);
    ctx.fillStyle=['#FFD700','#FF4444','#00FF00','#00FFFF'][i%4];
    ctx.fillRect(cx,cy,4,4);
  }
  // character with drip
  drawPixelChar(120,200,'#ffcc99','#000088',1,Math.floor(animTimer*0.05)%4,false,true,true);
  // gold chains (extra)
  for(let i=0;i<3;i++){
    ctx.strokeStyle='#FFD700';
    ctx.lineWidth=3;
    ctx.beginPath();
    ctx.arc(134,230+i*8,18-i*2,0,Math.PI*2);
    ctx.stroke();
  }
  // sunglasses label
  drawText('😎',108,195,16,'#fff');

  // THE END
  ctx.fillStyle='rgba(0,0,0,0.6)';
  ctx.fillRect(240,140,460,200);
  ctx.strokeStyle='#FFD700';ctx.lineWidth=3;
  ctx.strokeRect(240,140,460,200);

  drawText('THE END',W/2,210,22,'#FFD700','center');

  // flicker effect
  const alpha=0.5+0.5*Math.sin(animTimer*0.08);
  ctx.fillStyle=`rgba(255,215,0,${alpha})`;
  ctx.font="8px 'Press Start 2P'";
  ctx.textAlign='center';
  ctx.fillText('Look out for part 3!',W/2,270);
  ctx.textAlign='left';

  drawText('FINAL AURA: '+aura,W/2,310,7,'#00FF00','center');
  drawText('MADE BY DWAYNE THE ROCK',W/2,340,6,'#888','center');
}

// ======== KEY HANDLERS ========
document.addEventListener('keydown',e=>{
  keys[e.code]=true;
  if(gameState==='alley_fight'){
    if(e.code==='KeyE'&&!charDead){shoot();}
    if(e.code==='KeyR'&&!charDead){reload();}
  }
  if(gameState==='lance_fight'){
    if(e.code==='KeyQ'&&!qCooldown&&!lanceDead){talkTrash();}
  }
  e.preventDefault();
});
document.addEventListener('keyup',e=>{keys[e.code]=false;});

function shoot(){
  if(mag<=0){
    document.getElementById('reload-warning').style.display='block';
    return;
  }
  mag--;updateAmmo();
  const dir=P.facing;
  bullets.push({x:P.x+(dir>0?30:0),y:P.y+18,vx:dir*12,vy:0});
  spawnParticle(P.x+(dir>0?32:0),P.y+18,'#FFD700');
  // recoil
  P.x-=dir*3;
}

function reload(){
  if(stock<=0||mag===5)return;
  const need=5-mag;
  const take=Math.min(need,stock);
  mag+=take;stock-=take;
  updateAmmo();
  document.getElementById('reload-warning').style.display='none';
}

function talkTrash(){
  if(qPresses>=6)return;
  qCooldown=true;
  qPresses++;
  currentTrash=trashLines[Math.floor(Math.random()*4)];
  trashTimer=5*60;
  lanceStunTimer=5*60;
  lanceMoving=false;
  setTimeout(()=>{
    lanceMoving=(qPresses<6);
    qCooldown=false;
    if(qPresses>=6){
      // lance stops
      setTimeout(()=>{
        gameState='lance_cries';
        lanceCrying=true;
        clearOverlay();
        setTimeout(()=>{
          showOverlay(`<div class="textbox" style="bottom:20px;"><div class="speaker">Lance</div>EMOTIONAL DAMAGE!!</div>`,false);
          setTimeout(()=>{
            clearOverlay();
            lanceDead=true;lanceCrying=false;
            gameState='lance_fight';
            setTimeout(()=>{
              clearOverlay();
            },2000);
          },4000);
        },2000);
      },500);
    }
  },2500);
}

// init gang for fight
initGangMembers();

// start
gameLoop(0);
</script>
