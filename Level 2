<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gen Z Speedrun pt.2 - by Dwayne The Rock</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');
*{margin:0;padding:0;box-sizing:border-box;}
body{background:#000;font-family:'Press Start 2P',monospace;overflow:hidden;width:100vw;height:100vh;display:flex;align-items:center;justify-content:center;}
#game{width:800px;height:500px;position:relative;overflow:hidden;background:#000;border:3px solid #333;image-rendering:pixelated;}
canvas{display:block;image-rendering:pixelated;}
#ui{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;}
#aura-display{position:absolute;top:8px;left:8px;font-size:7px;color:#FFD700;background:rgba(0,0,0,0.8);padding:6px 8px;border:2px solid #FFD700;z-index:100;pointer-events:none;line-height:1.6;}
#aura-change{position:absolute;top:40px;left:8px;font-size:7px;font-weight:bold;z-index:100;pointer-events:none;opacity:0;transition:opacity 0.5s;}
#health-display{position:absolute;top:8px;right:8px;font-size:6px;color:#ff4444;background:rgba(0,0,0,0.8);padding:6px 8px;border:2px solid #ff4444;z-index:100;pointer-events:none;}
#ammo-display{position:absolute;bottom:8px;right:8px;font-size:6px;color:#fff;background:rgba(0,0,0,0.8);padding:6px 8px;border:2px solid #888;z-index:100;pointer-events:none;display:none;}
#reload-warning{position:absolute;bottom:40px;right:8px;font-size:7px;color:#ff0000;background:rgba(0,0,0,0.9);padding:4px 8px;border:2px solid #ff0000;z-index:100;pointer-events:none;display:none;animation:redflash 0.4s infinite;}
@keyframes redflash{0%,100%{opacity:1;}50%{opacity:0;}}
#scene{position:absolute;top:0;left:0;width:100%;height:100%;}
.btn{font-family:'Press Start 2P',monospace;cursor:pointer;border:3px solid;padding:10px 18px;font-size:8px;letter-spacing:1px;image-rendering:pixelated;transition:transform 0.1s,filter 0.1s;}
.btn:hover{transform:scale(1.05);filter:brightness(1.3);}
.btn:active{transform:scale(0.97);}
.btn-green{background:#003300;color:#00FF00;border-color:#00FF00;}
.btn-red{background:#330000;color:#FF4444;border-color:#FF4444;}
.btn-yellow{background:#332200;color:#FFD700;border-color:#FFD700;}
.btn-white{background:#111;color:#fff;border-color:#fff;}
.btn-blue{background:#000033;color:#4444FF;border-color:#4444FF;}
.btn-cyan{background:#003333;color:#00FFFF;border-color:#00FFFF;}
.textbox{background:rgba(0,0,0,0.92);border:3px solid #FFD700;padding:12px 16px;font-size:7px;color:#FFD700;line-height:1.8;position:absolute;bottom:20px;left:50%;transform:translateX(-50%);width:90%;z-index:50;min-height:50px;}
.textbox .speaker{color:#FF9900;font-size:6px;margin-bottom:6px;}
.choice-btn{display:block;width:100%;text-align:left;margin:5px 0;font-family:'Press Start 2P',monospace;font-size:6px;cursor:pointer;background:#001100;color:#00FF00;border:2px solid #00FF00;padding:8px 10px;pointer-events:all;}
.choice-btn:hover{background:#003300;filter:brightness(1.2);}
</style>
</head>
<body>
<div id="game">
  <div id="ui">
    <div id="aura-display">⚡ AURA: <span id="aura-val">1000</span></div>
    <div id="aura-change" id="aura-change"></div>
    <div id="health-display" style="display:none;">❤️ HP: <span id="hp-val">8</span>/8</div>
    <div id="ammo-display">🔫 <span id="mag-val">5</span>/5 | 📦 <span id="stock-val">25</span></div>
    <div id="reload-warning">⚠ RELOAD! [R]</div>
  </div>
  <canvas id="scene" width="800" height="500"></canvas>
  <div id="overlay" style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;"></div>
</div>

<script>
const canvas = document.getElementById('scene');
const ctx = canvas.getContext('2d');
const overlay = document.getElementById('overlay');
const W = 800, H = 500;

let aura = 1000;
let hp = 8;
let mag = 5;
let stock = 25;
let qPresses = 0;
let qCooldown = false;
let lanceHits = 0;
let playerHits = 0;
let bullets = [];
let enemyBullets = [];
let gangMembers = [];
let particles = [];
let gameState = 'title';
let keys = {};
let animTimer = 0;
let dialogueTimeout = null;
let frameId = null;
let lanceMoving = true;
let lanceCrying = false;
let lanceDead = false;
let lanceStunTimer = 0;
let bossDialogueStep = 0;
let gunVisible = false;
let gunSlideTimer = 0;
let gunSlideX = -200;
let uppercut = false;
let uppercutTimer = 0;
let charY = 0;
let charYVel = 0;
let charDead = false;
let bigDudeX = -150;
let bigDudeAnim = 0;

const P = {x:80,y:320,w:28,h:40,vx:0,vy:0,onGround:true,facing:1,frame:0,frameTimer:0};
const GANG_COLORS = ['#8B4513','#6B3410','#5C2D0E','#7A3B12','#9C4A1A'];

function updateAura(delta, label){
  aura = Math.max(0, aura + delta);
  document.getElementById('aura-val').textContent = aura;
  const el = document.getElementById('aura-change');
  el.textContent = (delta>0?'+':'')+delta+' AURA ('+(label||'')+')';
  el.style.color = delta>0?'#00FF00':'#FF4444';
  el.style.opacity = 1;
  setTimeout(()=>el.style.opacity=0,1500);
}

function setHP(v){
  hp = Math.max(0, v);
  document.getElementById('hp-val').textContent = hp;
}

function updateAmmo(){
  document.getElementById('mag-val').textContent = mag;
  document.getElementById('stock-val').textContent = stock;
  const rw = document.getElementById('reload-warning');
  rw.style.display = (mag <= 0 && stock > 0) ? 'block' : 'none';
}

function clearOverlay(){
  overlay.innerHTML = '';
  overlay.style.pointerEvents = 'none';
}

function showOverlay(html, clickable=true){
  overlay.innerHTML = html;
  overlay.style.pointerEvents = clickable ? 'all' : 'none';
}

function px(n){return Math.round(n);}

function drawPixelRect(x,y,w,h,color){
  ctx.fillStyle=color;
  ctx.fillRect(px(x),px(y),px(w),px(h));
}

function drawText(text,x,y,size=7,color='#fff',align='left'){
  ctx.save();
  ctx.font=`${size}px 'Press Start 2P'`;
  ctx.fillStyle=color;
  ctx.textAlign=align;
  ctx.fillText(text,px(x),px(y));
  ctx.restore();
}

function drawPixelChar(x,y,color1='#ffcc99',color2='#4444ff',facing=1,frame=0,dead=false,sunglasses=false,chains=false){
  const f=facing<0?-1:1;
  ctx.save();
  ctx.translate(px(x+14),px(y));
  ctx.scale(f,1);
  if(dead){ctx.translate(14,20);ctx.rotate(Math.PI/2);ctx.translate(-14,-20);}
  // shadow
  drawPixelRect(-14,38,28,4,'rgba(0,0,0,0.3)');
  // legs walk anim
  const legL = frame%2===0?0:3;
  const legR = frame%2===0?3:0;
  drawPixelRect(-7,28+legL,7,14,color2);
  drawPixelRect(0,28+legR,7,14,color2);
  // shoes
  drawPixelRect(-8,40+legL,9,4,'#222');
  drawPixelRect(0,40+legR,9,4,'#222');
  // body
  drawPixelRect(-10,10,20,20,color2);
  // arm anim
  const armL = frame%2===0?0:2;
  const armR = frame%2===0?2:0;
  drawPixelRect(-15,12+armL,6,16,'#cc9966');
  drawPixelRect(9,12+armR,6,16,'#cc9966');
  // head
  drawPixelRect(-8,-2,16,14,color1);
  // eyes
  drawPixelRect(-5,2,3,3,'#222');
  drawPixelRect(2,2,3,3,'#222');
  if(sunglasses){
    drawPixelRect(-7,1,6,4,'#00ccff');
    drawPixelRect(1,1,6,4,'#00ccff');
    drawPixelRect(-1,1,2,4,'#006699');
  }
  // mouth
  drawPixelRect(-3,8,6,2,'#cc6666');
  // gold chains
  if(chains){
    for(let i=0;i<3;i++){
      ctx.fillStyle='#FFD700';
      ctx.beginPath();
      ctx.arc(0,14+i*4,6-i,0,Math.PI*2);
      ctx.stroke();
      ctx.strokeStyle='#FFD700';
      ctx.lineWidth=2;
      ctx.beginPath();
      ctx.arc(0,14+i*4,6-i,0,Math.PI*2);
      ctx.stroke();
    }
  }
  ctx.restore();
}

function drawBigGuy(x,y,color='#5C2D0E',label='',size=1.5,beanie=false,boss=false,crying=false,dead=false){
  ctx.save();
  ctx.translate(px(x),px(y));
  ctx.scale(size,size);
  if(dead){ctx.translate(20,30);ctx.rotate(Math.PI/2);ctx.translate(-20,-30);}
  // shadow
  drawPixelRect(-20,58,40,6,'rgba(0,0,0,0.3)');
  // legs
  drawPixelRect(-14,36,13,24,color);
  drawPixelRect(1,36,13,24,color);
  drawPixelRect(-16,56,15,6,'#111');
  drawPixelRect(1,56,15,6,'#111');
  // huge body
  drawPixelRect(-18,8,36,30,color);
  // massive arms
  drawPixelRect(-30,10,14,28,color);
  drawPixelRect(16,10,14,28,color);
  // hands
  drawPixelRect(-32,36,16,12,color);
  drawPixelRect(16,36,16,12,color);
  // head
  drawPixelRect(-12,-2,24,18,color);
  // eyes
  drawPixelRect(-8,4,5,5,'#111');
  drawPixelRect(3,4,5,5,'#111');
  if(crying){
    // tears
    drawPixelRect(-7,10,2,8,'#88ccff');
    drawPixelRect(5,10,2,8,'#88ccff');
    drawPixelRect(-8,12,2,6,'#88ccff');
    drawPixelRect(4,12,2,6,'#88ccff');
    // squinty eyes
    ctx.fillStyle='#111';
    ctx.fillRect(-8,4,5,2);
    ctx.fillRect(3,4,5,2);
  }
  // mouth
  drawPixelRect(-4,12,8,3,'#cc6666');
  if(crying){drawPixelRect(-6,12,12,3,'#cc6666');}
  // beanie
  if(beanie){
    drawPixelRect(-13,-10,26,12,'#222');
    drawPixelRect(-10,-14,20,6,'#333');
    drawPixelRect(-9,-16,18,4,'#444');
  }
  // boss bling
  if(boss){
    ctx.fillStyle='#FFD700';
    for(let i=0;i<4;i++){
      drawPixelRect(-14+i*8,8,6,4,'#FFD700');
    }
  }
  // label
  if(label){
    ctx.restore();
    ctx.save();
    ctx.font="7px 'Press Start 2P'";
    ctx.fillStyle='#FFD700';
    ctx.textAlign='center';
    ctx.fillText(label,px(x+size*0),px(y-10));
  }
  ctx.restore();
}

function drawBullet(x,y,dir=1,color='#FFD700'){
  ctx.fillStyle=color;
  ctx.fillRect(px(x),px(y),px(8),px(3));
  // trail
  ctx.fillStyle='rgba(255,200,0,0.4)';
  ctx.fillRect(px(x-dir*6),px(y+1),px(6),px(1));
}

function drawGround(color='#333',lineColor='#555'){
  ctx.fillStyle=color;
  ctx.fillRect(0,380,W,120);
  // grid lines
  ctx.strokeStyle=lineColor;
  ctx.lineWidth=1;
  for(let x=0;x<W;x+=40){
    ctx.beginPath();ctx.moveTo(x,380);ctx.lineTo(x+20,500);ctx.stroke();
  }
  for(let y=380;y<500;y+=20){
    ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();
  }
}

function drawAlleyBG(){
  // sky
  ctx.fillStyle='#0a0a1a';
  ctx.fillRect(0,0,W,H);
  // stars
  ctx.fillStyle='#ffffff';
  for(let i=0;i<30;i++){
    const sx=(i*137)%W, sy=(i*97)%200;
    if(i%3===0){ctx.fillRect(sx,sy,2,2);}else{ctx.fillRect(sx,sy,1,1);}
  }
  // walls
  ctx.fillStyle='#1a1a1a';
  ctx.fillRect(0,60,120,380);
  ctx.fillRect(680,60,120,380);
  // brick pattern left
  ctx.fillStyle='#2a1a1a';
  for(let ry=60;ry<440;ry+=18){
    for(let rx=0;rx<120;rx+=36){
      ctx.fillRect(rx+(ry%36<18?0:18),ry,34,16);
    }
  }
  // brick pattern right
  for(let ry=60;ry<440;ry+=18){
    for(let rx=680;rx<800;rx+=36){
      ctx.fillRect(rx+(ry%36<18?0:18),ry,34,16);
    }
  }
  // graffiti
  ctx.fillStyle='#ff000066';
  ctx.font="bold 14px 'Press Start 2P'";
  ctx.fillText('HOOD',10,200);
  ctx.fillStyle='#0000ff66';
  ctx.fillText('GANG',690,300);
  // ground
  drawGround('#222','#333');
  // alley lines
  ctx.strokeStyle='#444';
  ctx.lineWidth=2;
  ctx.beginPath();ctx.moveTo(120,H);ctx.lineTo(120,60);ctx.stroke();
  ctx.beginPath();ctx.moveTo(680,H);ctx.lineTo(680,60);ctx.stroke();
  // trash/barrels
  ctx.fillStyle='#3a3a1a';
  ctx.fillRect(130,340,30,40);
  ctx.fillStyle='#555';
  ctx.fillRect(133,335,24,8);
  ctx.fillStyle='#3a3a1a';
  ctx.fillRect(170,350,25,30);
  // streetlamp
  ctx.fillStyle='#888';
  ctx.fillRect(390,80,8,220);
  ctx.fillStyle='#887';
  ctx.fillRect(380,76,28,8);
  ctx.fillStyle='rgba(255,240,100,0.12)';
  ctx.beginPath();
  ctx.moveTo(394,84);
  ctx.lineTo(310,380);
  ctx.lineTo(480,380);
  ctx.closePath();
  ctx.fill();
  ctx.fillStyle='#FFEE80';
  ctx.fillRect(382,78,24,6);
}

function drawBurgerKingBG(){
  // walls
  ctx.fillStyle='#cc4400';
  ctx.fillRect(0,0,W,H);
  // floor tiles
  ctx.fillStyle='#f5e8c0';
  ctx.fillRect(0,320,W,180);
  for(let tx=0;tx<W;tx+=40){
    for(let ty=320;ty<500;ty+=40){
      ctx.strokeStyle='#ddd0a0';
      ctx.lineWidth=1;
      ctx.strokeRect(tx,ty,40,40);
    }
  }
  // ceiling
  ctx.fillStyle='#aa3300';
  ctx.fillRect(0,0,W,40);
  // BK logo area
  ctx.fillStyle='#FFD700';
  ctx.font="bold 12px 'Press Start 2P'";
  ctx.textAlign='center';
  ctx.fillText('BURGER KING',W/2,28);
  ctx.textAlign='left';
  // counter
  ctx.fillStyle='#8B4513';
  ctx.fillRect(0,200,200,180);
  ctx.fillStyle='#cc6600';
  ctx.fillRect(0,195,205,12);
  // tables
  const tables = [[250,240],[450,240],[600,240],[300,310],[520,310]];
  tables.forEach(([tx,ty])=>{
    ctx.fillStyle='#8B4513';
    ctx.fillRect(tx,ty,80,40);
    ctx.fillStyle='#cc6600';
    ctx.fillRect(tx-5,ty-5,90,8);
    // chairs
    ctx.fillStyle='#5C3317';
    ctx.fillRect(tx+5,ty+38,18,16);
    ctx.fillRect(tx+52,ty+38,18,16);
  });
  // bathroom arrow/sign
  ctx.fillStyle='#00aa00';
  ctx.fillRect(640,40,120,50);
  ctx.fillStyle='#ffffff';
  ctx.font="6px 'Press Start 2P'";
  ctx.textAlign='center';
  ctx.fillText('BATHROOMS',700,62);
  ctx.fillText('---->',700,78);
  ctx.textAlign='left';
  // bathroom door
  ctx.fillStyle='#5C3317';
  ctx.fillRect(730,150,50,170);
  ctx.fillStyle='#8B4513';
  ctx.fillRect(730,148,50,8);
  ctx.fillStyle='#cc9900';
  ctx.fillRect(755,225,6,12);
}

function drawBathroomBG(){
  // tiles
  ctx.fillStyle='#ddd';
  ctx.fillRect(0,0,W,H);
  for(let tx=0;tx<W;tx+=30){
    for(let ty=0;ty<H;ty+=30){
      ctx.strokeStyle='#bbb';
      ctx.lineWidth=1;
      ctx.strokeRect(tx,ty,30,30);
    }
  }
  // floor
  ctx.fillStyle='#e8e8e8';
  ctx.fillRect(0,360,W,140);
  // urinal
  ctx.fillStyle='#fff';
  ctx.fillRect(80,120,60,100);
  ctx.fillStyle='#ddd';
  ctx.fillRect(82,122,56,96);
  ctx.fillStyle='#aaa';
  ctx.fillRect(90,218,44,20);
  // stall 1 (left, open-able)
  ctx.fillStyle='#8B4513';
  ctx.fillRect(200,80,8,280);
  ctx.fillRect(200,80,150,8);
  ctx.fillRect(200,356,150,8);
  ctx.fillStyle='#cc9966';
  ctx.fillRect(208,88,142,276);
  // toilet inside stall 1
  ctx.fillStyle='#fff';
  ctx.fillRect(230,260,80,80);
  ctx.fillStyle='#eee';
  ctx.fillRect(235,255,70,15);
  // stall 2
  ctx.fillStyle='#8B4513';
  ctx.fillRect(480,80,8,280);
  ctx.fillRect(480,80,200,8);
  ctx.fillRect(480,356,200,8);
  ctx.fillStyle='#5a3311';
  ctx.fillRect(488,88,192,276);
  // sinks
  ctx.fillStyle='#ccc';
  ctx.fillRect(600,200,60,40);
  ctx.fillRect(680,200,60,40);
  ctx.fillStyle='#aaa';
  ctx.fillRect(610,218,10,20);
  ctx.fillRect(690,218,10,20);
  // mirror
  ctx.fillStyle='#88ccff';
  ctx.fillRect(600,120,140,60);
  ctx.strokeStyle='#aaa';
  ctx.lineWidth=3;
  ctx.strokeRect(600,120,140,60);
}

function drawDialogueSide(charLeft=true,charRight=true,bossRight=true){
  ctx.fillStyle='#0a0a0a';
  ctx.fillRect(0,0,W,H);
  ctx.fillStyle='#111';
  ctx.fillRect(0,320,W,180);
  for(let x=0;x<W;x+=20){
    ctx.fillStyle=x%40===0?'#1a1a1a':'#151515';
    ctx.fillRect(x,320,20,180);
  }
  // divider
  ctx.fillStyle='#FFD700';
  ctx.fillRect(W/2-2,0,4,320);
  // char label
  ctx.fillStyle='#00FF00';
  ctx.font="7px 'Press Start 2P'";
  ctx.textAlign='center';
  ctx.fillText('YOU',W/4,30);
  ctx.textAlign='left';
}

// -------- SCENES --------

function initGangMembers(){
  gangMembers = [];
  for(let i=0;i<5;i++){
    gangMembers.push({
      x:550+i*30,y:320,
      hp:2,
      dead:false,
      shootTimer:60+i*20,
      moveTimer:0,
      frame:0,
      frameTimer:0,
      hasGun: false,
      gunRevealAnim: 0
    });
  }
}

function initAlleyPlayer(){
  P.x=80;P.y=320;P.vx=0;P.vy=0;P.facing=1;P.frame=0;
  hp=8;setHP(hp);
  mag=5;stock=25;updateAmmo();
  bullets=[];enemyBullets=[];particles=[];
  playerHits=0;charDead=false;
}

function spawnParticle(x,y,color='#FFD700'){
  for(let i=0;i<6;i++){
    const angle=Math.random()*Math.PI*2;
    const spd=2+Math.random()*4;
    particles.push({x,y,vx:Math.cos(angle)*spd,vy:Math.sin(angle)*spd,life:20,maxLife:20,color});
  }
}

function updateParticles(){
  particles=particles.filter(p=>{
    p.x+=p.vx;p.y+=p.vy;p.vy+=0.3;p.life--;
    return p.life>0;
  });
}

function drawParticles(){
  particles.forEach(p=>{
    ctx.globalAlpha=p.life/p.maxLife;
    ctx.fillStyle=p.color;
    ctx.fillRect(px(p.x),px(p.y),3,3);
  });
  ctx.globalAlpha=1;
}

// ======== MAIN GAME LOOP ========
let lastTime=0;
function gameLoop(ts){
  const dt=Math.min((ts-lastTime)/16.7,3);lastTime=ts;
  animTimer+=dt;
  ctx.clearRect(0,0,W,H);

  if(gameState==='title') drawTitle();
  else if(gameState==='alley_walk') drawAlleyWalk(dt);
  else if(gameState==='alley_fight') drawAlleyFight(dt);
  else if(gameState==='dialogue_boss_1') drawDialogueBoss1();
  else if(gameState==='dialogue_choice') drawDialogueChoice();
  else if(gameState==='boss_says_wrong') drawBossWrong();
  else if(gameState==='gun_reveal') drawGunReveal(dt);
  else if(gameState==='dialogue_boss_rob') drawBossRob();
  else if(gameState==='burger_king') drawBurgerKingScene(dt);
  else if(gameState==='bathroom') drawBathroomScene(dt);
  else if(gameState==='lance_fight') drawLanceFight(dt);
  else if(gameState==='lance_cries') drawLanceCries(dt);
  else if(gameState==='stall_enter') drawStallEnter();
  else if(gameState==='boss_final') drawBossFinal();
  else if(gameState==='ending') drawEnding();
  else if(gameState==='died_fight') drawDiedFight();
  else if(gameState==='died_giant') drawDiedGiant();
  else if(gameState==='died_lance') drawDiedLance();
  else if(gameState==='giant_appears') drawGiantAppears(dt);

  frameId=requestAnimationFrame(gameLoop);
}

// ======== TITLE ========
function drawTitle(){
  // bg - dark with pixel dudes
  ctx.fillStyle='#050510';
  ctx.fillRect(0,0,W,H);
  // stars
  ctx.fillStyle='#ffffff';
  for(let i=0;i<50;i++){
    const sx=(i*137+animTimer)%W, sy=(i*97)%350;
    ctx.fillRect(sx,sy,1+(i%3===0?1:0),1+(i%3===0?1:0));
  }
  // muscular gang dudes in bg (silhouettes)
  const positions=[80,200,340,500,650];
  positions.forEach((bx,i)=>{
    const pulse=Math.sin(animTimer*0.05+i)*3;
    ctx.globalAlpha=0.35+i*0.08;
    drawBigGuy(bx,280+pulse,'#1a0a05','',1.8,true,i===2);
    ctx.globalAlpha=1;
  });
  // title box
  ctx.fillStyle='rgba(0,0,0,0.85)';
  ctx.fillRect(60,60,680,160);
  ctx.strokeStyle='#FFD700';
  ctx.lineWidth=3;
  ctx.strokeRect(60,60,680,160);
  // pixel corner decorations
  ctx.fillStyle='#FFD700';
