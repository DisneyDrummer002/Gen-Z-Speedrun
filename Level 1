  }
  ctx.restore();
}

function changeFit(dir){
  GS.currentFit=((GS.currentFit+dir)+3)%3;
  GS.fitSelected=true;
  const names=['SUIT & TIE','FEAR OF GOD ATHLETICS\nOVERSIZED TEE','CLEAN BLUE\nATHLETIC TEE'];
  document.getElementById('fit-name').textContent=names[GS.currentFit];
  document.getElementById('fit-next-btn').style.display='block';
}

// ============ VIRAL PHONE ============
function initViral(){
  const c=document.getElementById('viral-canvas');
  const ctx=c.getContext('2d');
  resizeCanvas(c);
  GS.views=0; GS.controlsActive=true;
  document.getElementById('views-display').textContent='VIEWS: 0';

  let charEmoting=false, charSaying=false, phrase='', emoteT=0;
  let t=0;

  GS.viralKD=(e)=>{
    if(!GS.controlsActive) return;
    if(e.key==='f'||e.key==='F'){ charEmoting=true; emoteT=0; addViews(); }
    if(e.key==='j'||e.key==='J'){ charSaying=true; phrase=Math.random()>.5?'SIX SEVENNNN':'CLOCK IT!'; emoteT=0; addViews(); }
  };
  document.addEventListener('keydown',GS.viralKD);

  function addViews(){
    GS.views+=10;
    if(GS.views>=500){
      GS.views=500; document.getElementById('views-display').textContent='VIEWS: 5M 🔥';
      GS.controlsActive=false;
      setTimeout(()=>goTo('screen-gone-viral'),1800);
    } else {
      document.getElementById('views-display').textContent='VIEWS: '+GS.views;
    }
  }

  function frame(){
    if(!document.getElementById('screen-viral').classList.contains('active')) return;
    requestAnimationFrame(frame);
    ctx.clearRect(0,0,c.width,c.height);
    ctx.fillStyle='#0d0d0d'; ctx.fillRect(0,0,c.width,c.height);

    // scattered 67s in bg
    ctx.font='14px monospace'; ctx.fillStyle='#333';
    for(let i=0;i<12;i++) ctx.fillText('67',(i*173+t)%c.width,(i*97+t*.5)%c.height);

    // Phone
    const pw=200,ph=360;
    const px=c.width/2-pw/2,py=c.height/2-ph/2;
    // Phone body
    ctx.fillStyle='#1a1a1a'; roundRect(ctx,px-12,py-12,pw+24,ph+24,28); ctx.fill();
    ctx.strokeStyle='#444'; ctx.lineWidth=2; roundRect(ctx,px-12,py-12,pw+24,ph+24,28); ctx.stroke();
    ctx.fillStyle='#0a0a0a'; roundRect(ctx,px,py,pw,ph,14); ctx.fill();
    // notch
    ctx.fillStyle='#1a1a1a'; roundRect(ctx,px+pw/2-25,py+4,50,12,8); ctx.fill();

    // YT header
    ctx.fillStyle='#ff0000'; roundRect(ctx,px+pw/2-30,py+20,60,36,6); ctx.fill();
    ctx.fillStyle='#fff'; ctx.font='bold 8px monospace'; ctx.fillText('YouTube',px+pw/2-26,py+40);
    // Play button
    ctx.fillStyle='#fff';
    ctx.beginPath(); ctx.moveTo(px+pw/2+22,py+24); ctx.lineTo(px+pw/2+36,py+38); ctx.lineTo(px+pw/2+22,py+52); ctx.fill();

    // Screen content clip
    ctx.save();
    ctx.beginPath(); roundRect(ctx,px+2,py+60,pw-4,ph-70,6); ctx.clip();
    ctx.fillStyle='#1a1a2e'; ctx.fillRect(px,py+60,pw,ph-70);

    // Draw character
    const charX=px+pw/2, charY=py+ph*.7;
    if(charEmoting){
      emoteT++;
      drawDancingChar(ctx,charX,charY,emoteT,GS.currentFit);
      if(emoteT>45) charEmoting=false;
    } else {
      drawFitChar(ctx,charX,charY,GS.currentFit,t*.04);
    }

    if(charSaying&&emoteT<55){
      ctx.fillStyle='rgba(255,255,255,0.95)'; roundRect(ctx,px+12,py+ph*.32,pw-24,34,6); ctx.fill();
      ctx.fillStyle='#000'; ctx.font='bold 8px monospace'; ctx.fillText(phrase,px+20,py+ph*.32+22);
      if(emoteT>48) charSaying=false;
    }
    ctx.restore();

    // Progress bar
    const prog=GS.views/500;
    ctx.fillStyle='#333'; ctx.fillRect(px,py+ph+16,pw,10);
    ctx.fillStyle='#ff0000'; ctx.fillRect(px,py+ph+16,pw*prog,10);
    ctx.fillStyle='#fff'; ctx.font='7px monospace'; ctx.fillText('TO VIRAL',px+pw/2-24,py+ph+36);

    t++;
  }
  frame();
}

function drawDancingChar(ctx,x,y,t,fitIdx){
  const fc=FIT_COLORS[fitIdx];
  ctx.save(); ctx.translate(x,y);
  const jump=-Math.abs(Math.sin(t*.18))*22;
  ctx.translate(0,jump);
  const tilt=Math.sin(t*.28)*18;
  ctx.rotate(tilt*Math.PI/180);
  ctx.fillStyle='#F4C17A'; ctx.fillRect(-9,-28,18,18);
  ctx.fillStyle='#222'; ctx.fillRect(-10,-30,20,12);
  ctx.fillStyle='#000'; ctx.fillRect(-6,-22,4,4); ctx.fillRect(3,-22,4,4);
  ctx.fillStyle=fc[0]; ctx.fillRect(-14,-10,28,28);
  const aw=Math.sin(t*.35)*22;
  ctx.fillStyle=fc[2];
  ctx.save(); ctx.rotate((-40+aw)*Math.PI/180); ctx.fillRect(-4,-26,8,24); ctx.restore();
  ctx.save(); ctx.rotate((40-aw)*Math.PI/180); ctx.fillRect(-4,-26,8,24); ctx.restore();
  ctx.fillStyle=fc[1]; ctx.fillRect(-9,16,8,24); ctx.fillRect(2,16,8,24);
  ctx.fillStyle='#fff'; ctx.fillRect(-12,38,12,7); ctx.fillRect(2,38,12,7);
  ctx.restore();
}

// ============ GONE VIRAL ============
function initGoneViral(){
  const c=document.getElementById('fireworks-canvas');
  const ctx=c.getContext('2d');
  resizeCanvas(c);

  // viral char
  const vc=document.getElementById('viral-char-canvas');
  const vctx=vc.getContext('2d');
  vctx.clearRect(0,0,120,160);
  vctx.fillStyle='#0a0a1a'; vctx.fillRect(0,0,120,160);
  // head
  vctx.fillStyle='#F4C17A'; vctx.fillRect(40,8,40,36);
  vctx.fillStyle='#222'; vctx.fillRect(38,6,44,18);
  // sunglasses
  vctx.fillStyle='#000'; vctx.fillRect(43,20,16,12); vctx.fillRect(62,20,16,12);
  vctx.fillStyle='rgba(80,80,255,0.4)'; vctx.fillRect(44,21,14,10); vctx.fillRect(63,21,14,10);
  vctx.fillStyle='#555'; vctx.fillRect(59,23,4,6);
  // mouth smirk
  vctx.fillStyle='#c47050'; vctx.fillRect(52,36,16,5);
  // suit
  vctx.fillStyle='#111'; vctx.fillRect(26,44,68,60);
  vctx.fillStyle='#fff'; vctx.fillRect(50,44,20,50);
  vctx.fillStyle='#FFD700'; vctx.fillRect(56,44,8,38);
  // lapels
  vctx.fillStyle='#0a0a0a';
  vctx.beginPath(); vctx.moveTo(26,44); vctx.lineTo(50,64); vctx.lineTo(56,44); vctx.fill();
  vctx.beginPath(); vctx.moveTo(94,44); vctx.lineTo(70,64); vctx.lineTo(64,44); vctx.fill();
  // arms crossed
  vctx.fillStyle='#111'; vctx.fillRect(14,50,28,16); vctx.fillRect(78,50,28,16);
  vctx.fillStyle='#F4C17A'; vctx.fillRect(14,62,18,12); vctx.fillRect(88,62,18,12);
  // pants
  vctx.fillStyle='#222'; vctx.fillRect(34,102,22,40); vctx.fillRect(64,102,22,40);
  vctx.fillStyle='#111'; vctx.fillRect(32,140,26,12); vctx.fillRect(62,140,26,12);

  let fw=[];
  for(let i=0;i<20;i++) fw.push({x:Math.random()*c.width,y:c.height,vy:-6-Math.random()*5,exploded:false,pts:[],col:['#FFD700','#ff6600','#ff00ff','#00ffff','#ff0000','#00ff88'][i%6]});

  function frame(){
    if(!document.getElementById('screen-gone-viral').classList.contains('active')) return;
    requestAnimationFrame(frame);
    ctx.fillStyle='rgba(10,10,26,0.14)'; ctx.fillRect(0,0,c.width,c.height);
    fw.forEach(f=>{
      if(!f.exploded){
        f.y+=f.vy;
        ctx.fillStyle=f.col; ctx.globalAlpha=1;
        ctx.fillRect(f.x-2,f.y,5,10);
        if(f.y<c.height*.35+Math.random()*80){
          f.exploded=true;
          for(let j=0;j<24;j++) f.pts.push({x:f.x,y:f.y,vx:(Math.random()-.5)*7,vy:(Math.random()-.5)*7,life:60+Math.random()*30});
        }
      } else {
        f.pts.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.08;p.life--;ctx.globalAlpha=Math.max(0,p.life/80);ctx.fillStyle=f.col;ctx.fillRect(p.x-2,p.y-2,5,5);});
        ctx.globalAlpha=1;
        if(f.pts.every(p=>p.life<=0)){f.x=Math.random()*c.width;f.y=c.height;f.vy=-6-Math.random()*5;f.exploded=false;f.pts=[];}
      }
    });
    ctx.globalAlpha=1;
  }
  frame();
  setTimeout(()=>{ document.getElementById('viral-next-btn').style.display='block'; },10000);
}

// ============ END ============
function drawEndCanvas(){
  const c=document.getElementById('end-canvas');
  const ctx=c.getContext('2d');
  resizeCanvas(c);
  let t=0;
  function frame(){
    if(!document.getElementById('screen-end').classList.contains('active')) return;
    requestAnimationFrame(frame);
    ctx.fillStyle='#000'; ctx.fillRect(0,0,c.width,c.height);
    for(let i=0;i<40;i++){
      ctx.globalAlpha=.2+.8*Math.abs(Math.sin(t*.025+i*.4));
      ctx.fillStyle='#FFD700';
      ctx.fillRect((i*137+t*.4)%c.width,(i*89+t*.2)%c.height,3,3);
    }
    ctx.globalAlpha=1;
    t++;
  }
  frame();
}
