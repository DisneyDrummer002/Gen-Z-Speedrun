function initBasketball(){
  const c = document.getElementById('bball-canvas');
  const ctx = c.getContext('2d');
  resizeCanvas(c);
  const W=c.width, H=c.height;
  const HOOP_X=W/2, HOOP_Y=H*.14;
  const CL=30,CR=W-30,CT=H*.09,CB=H*.96;

  let player={x:W/2,y:H*.72,hasBall:true};
  let defenders=[
    {x:W/2-70,y:H*.4,phase:0},{x:W/2+70,y:H*.38,phase:1.5},{x:W/2,y:H*.32,phase:3}
  ];
  let ball={inAir:false,arcT:0,startX:0,startY:0,made:false};
  let timeLeft=30, gameDone=false, victoryMode=false, victoryT=0;
  let walkT=0;

  document.getElementById('timer-display').textContent=':30';
  document.getElementById('swish-text').style.display='none';

  GS.bballKeys={};
  GS.bballKD=(e)=>{ GS.bballKeys[e.key]=true; if(['w','a','s','d','e','W','A','S','D','E'].includes(e.key)) e.preventDefault(); };
  GS.bballKU=(e)=>{ GS.bballKeys[e.key]=false; };
  document.addEventListener('keydown',GS.bballKD);
  document.addEventListener('keyup',GS.bballKU);

  GS.bballTimer=setInterval(()=>{
    if(gameDone) return;
    timeLeft--;
    document.getElementById('timer-display').textContent=':'+(timeLeft<10?'0'+timeLeft:timeLeft);
    if(timeLeft<=0){
      gameDone=true;
      clearInterval(GS.bballTimer);
      document.getElementById('swish-text').style.fontSize='14px';
      document.getElementById('swish-text').style.color='#ff4444';
      document.getElementById('swish-text').textContent='TIME UP! RESTARTING...';
      document.getElementById('swish-text').style.display='block';
      setTimeout(()=>{ initBasketball(); },2200);
    }
  },1000);

  function loop(){
    if(!document.getElementById('screen-basketball').classList.contains('active')) return;
    requestAnimationFrame(loop);
    ctx.clearRect(0,0,W,H);
    drawCourt(ctx,W,H);
    drawSpectators(ctx,W,H,walkT);

    if(!gameDone && !victoryMode){
      let dx=0,dy=0;
      if(GS.bballKeys['w']||GS.bballKeys['W']) dy=-2.8;
      if(GS.bballKeys['s']||GS.bballKeys['S']) dy=2.8;
      if(GS.bballKeys['a']||GS.bballKeys['A']) dx=-2.8;
      if(GS.bballKeys['d']||GS.bballKeys['D']) dx=2.8;

      // defender blocking
      let blocked=false;
      defenders.forEach(d=>{
        const dist=Math.hypot(d.x-player.x,d.y-player.y);
        if(dist<32) blocked=true;
      });
      if(!blocked){
        player.x=Math.max(CL+12,Math.min(CR-12,player.x+dx));
        player.y=Math.max(CT+12,Math.min(CB-12,player.y+dy));
      }
      if(dx||dy) walkT+=0.18; else walkT+=0.05;

      // move defenders
      defenders.forEach((d,i)=>{
        d.phase+=0.012;
        const tx=player.x+Math.cos(d.phase+i)*55;
        const ty=player.y+Math.sin(d.phase+i*1.3)*40;
        d.x+=(tx-d.x)*0.04;
        d.y+=(ty-d.y)*0.04;
        d.x=Math.max(CL+16,Math.min(CR-16,d.x));
        d.y=Math.max(CT+20,Math.min(CB-20,d.y));
      });

      // shoot
      if((GS.bballKeys['e']||GS.bballKeys['E'])&&player.hasBall&&!ball.inAir){
        delete GS.bballKeys['e']; delete GS.bballKeys['E'];
        ball.inAir=true; ball.arcT=0;
        ball.startX=player.x; ball.startY=player.y-14;
        player.hasBall=false;
        const dist=Math.hypot(player.x-HOOP_X,player.y-HOOP_Y);
        // good angle = within 140px, not too close
        ball.made=(dist<140&&dist>25&&Math.random()<0.58);
      }
    }

    // animate ball arc
    if(ball.inAir){
      ball.arcT+=0.026;
      const bt=ball.arcT;
      const bx=ball.startX+(HOOP_X-ball.startX)*bt;
      const by=ball.startY+(HOOP_Y-ball.startY)*bt - Math.sin(bt*Math.PI)*90;
      drawPixelBall(ctx,bx,by);
      if(bt>=1){
        ball.inAir=false;
        if(ball.made&&!gameDone){
          gameDone=true;
          clearInterval(GS.bballTimer);
          document.removeEventListener('keydown',GS.bballKD); GS.bballKD=null;
          document.removeEventListener('keyup',GS.bballKU); GS.bballKU=null;
          document.getElementById('swish-text').textContent='SWISH! 🏀';
          document.getElementById('swish-text').style.fontSize='22px';
          document.getElementById('swish-text').style.color='#FFD700';
          document.getElementById('swish-text').style.display='block';
          updateAura(460);
          victoryMode=true;
          setTimeout(()=>{
            document.getElementById('swish-text').style.display='none';
            goTo('screen-victory');
            initVictoryScreen();
          },3000);
        } else if(!ball.made){
          player.hasBall=true;
          player.x=ball.startX+(Math.random()-0.5)*40;
          player.y=ball.startY+60;
        }
      }
    } else if(player.hasBall&&!gameDone){
      drawPixelBall(ctx,player.x+10,player.y-2);
    }

    // draw defenders
    defenders.forEach(d=>drawPixelDefender(ctx,d.x,d.y,walkT));
    // draw player
    if(victoryMode){
      victoryT+=0.12;
      drawVictoryDance(ctx,player.x,player.y,victoryT);
    } else {
      drawPixelPlayer(ctx,player.x,player.y,walkT,player.hasBall,null);
    }
    // hoop indicator
    ctx.strokeStyle='rgba(255,100,0,0.6)'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.arc(HOOP_X,HOOP_Y,16,0,Math.PI*2); ctx.stroke();
  }
  loop();
}

