<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gen Z Speedrun - by Dwayne "The Rock"</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');
*{margin:0;padding:0;box-sizing:border-box;}
html,body{width:100%;height:100%;overflow:hidden;background:#0a0a1a;}
body{font-family:'Press Start 2P',monospace,sans-serif;}
#game{position:relative;width:100vw;height:100vh;background:#0a0a1a;}
.screen{position:absolute;top:0;left:0;width:100%;height:100%;display:none;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;}
.screen.active{display:flex;}
.pixel-btn{
  font-family:'Press Start 2P',monospace;
  font-size:10px;padding:14px 28px;
  background:#FFD700;color:#000;
  border:4px solid #fff;cursor:pointer;
  box-shadow:5px 5px 0 #555;
  transition:transform 0.08s;
  text-transform:uppercase;letter-spacing:1px;
  line-height:1.4;
}
.pixel-btn:hover{transform:scale(1.06);box-shadow:7px 7px 0 #555;}
.pixel-btn:active{transform:scale(0.95);box-shadow:2px 2px 0 #555;}
.screen-title{
  font-family:'Press Start 2P',monospace;
  color:#FFD700;text-align:center;
  text-shadow:3px 3px 0 #ff6600,6px 6px 0 #ff0000;
  margin-bottom:20px;line-height:1.8;
}
#aura-counter{
  position:fixed;top:10px;left:10px;
  font-family:'Press Start 2P',monospace;font-size:9px;
  color:#00ff88;background:rgba(0,0,0,0.85);
  padding:8px 14px;border:2px solid #00ff88;z-index:9999;
  pointer-events:none;
}
#aura-flash{
  position:fixed;top:46px;left:10px;
  font-family:'Press Start 2P',monospace;font-size:11px;
  background:rgba(0,0,0,0.9);padding:6px 12px;
  border:2px solid #FFD700;z-index:9999;display:none;
  pointer-events:none;
}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.45;}}
@keyframes floatUp{0%{transform:translateY(0);opacity:1;}100%{transform:translateY(-80px);opacity:0;}}
canvas{display:block;image-rendering:pixelated;image-rendering:crisp-edges;}
</style>
</head>
<body>
<div id="aura-counter">AURA: <span id="aura-val">0</span></div>
<div id="aura-flash"></div>
<div id="game">

<!-- TITLE SCREEN -->
<div class="screen active" id="screen-title">
  <canvas id="title-canvas" style="position:absolute;top:0;left:0;width:100%;height:100%;"></canvas>
  <div style="position:relative;z-index:10;text-align:center;">
    <div style="font-family:'Press Start 2P',monospace;font-size:clamp(16px,4vw,36px);color:#FFD700;text-shadow:4px 4px 0 #ff6600,8px 8px 0 #000;margin-bottom:10px;line-height:1.6;">GEN Z</div>
    <div style="font-family:'Press Start 2P',monospace;font-size:clamp(14px,3vw,28px);color:#fff;text-shadow:3px 3px 0 #0066ff;margin-bottom:12px;line-height:1.6;">SPEEDRUN</div>
    <div style="font-family:'Press Start 2P',monospace;font-size:8px;color:#888;margin-bottom:36px;">by Dwayne "The Rock"</div>
    <button class="pixel-btn" onclick="startGame()" style="font-size:10px;background:#ff3300;color:#fff;border-color:#FFD700;animation:pulse 1s infinite;">SPEEDRUN THE Z</button>
  </div>
</div>

<!-- LEVEL 1 INTRO -->
<div class="screen" id="screen-l1intro" style="background:#0a0a1a;">
  <div style="text-align:center;padding:30px;">
    <div class="screen-title" style="font-size:clamp(11px,2.5vw,20px);margin-bottom:36px;">LEVEL ONE:<br><br>AURA FARMING</div>
    <button class="pixel-btn" onclick="goTo('screen-basketball')" style="background:#00ff88;color:#000;">YES BRO</button>
  </div>
</div>

<!-- BASKETBALL SCREEN -->
<div class="screen" id="screen-basketball" style="background:#1a1a2e;">
  <canvas id="bball-canvas" style="position:absolute;top:0;left:0;width:100%;height:100%;"></canvas>
  <div style="position:absolute;top:10px;left:50%;transform:translateX(-50%);font-family:'Press Start 2P',monospace;font-size:8px;color:#FFD700;text-align:center;background:rgba(0,0,0,0.75);padding:7px 14px;border:2px solid #FFD700;z-index:10;white-space:nowrap;">OBJECTIVE: HIT THE BUZZER BEATER</div>
  <div id="timer-display" style="position:absolute;top:10px;right:12px;font-family:'Press Start 2P',monospace;font-size:12px;color:#ff4444;background:rgba(0,0,0,0.8);padding:7px 12px;border:2px solid #ff4444;z-index:10;">:30</div>
  <div style="position:absolute;bottom:10px;left:50%;transform:translateX(-50%);font-family:'Press Start 2P',monospace;font-size:7px;color:#aaa;background:rgba(0,0,0,0.7);padding:5px 10px;z-index:10;white-space:nowrap;">W/A/S/D = MOVE &nbsp;|&nbsp; E = SHOOT</div>
  <div id="swish-text" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-family:'Press Start 2P',monospace;font-size:20px;color:#FFD700;display:none;z-index:20;text-shadow:4px 4px 0 #ff6600;text-align:center;"></div>
</div>

<!-- VICTORY / OBJECTIVE COMPLETE -->
<div class="screen" id="screen-victory" style="background:#0a0a1a;">
  <canvas id="victory-canvas" style="position:absolute;top:0;left:0;width:100%;height:100%;"></canvas>
  <div style="position:relative;z-index:10;text-align:center;background:rgba(0,0,0,0.6);padding:30px;border:3px solid #FFD700;">
    <div style="font-size:36px;margin-bottom:16px;">✅</div>
    <div class="screen-title" style="font-size:clamp(10px,2vw,16px);margin-bottom:10px;">OBJECTIVE COMPLETE</div>
    <div style="font-family:'Press Start 2P',monospace;font-size:9px;color:#aaa;margin-bottom:28px;">HIT THE BUZZER BEATER</div>
    <button class="pixel-btn" onclick="goTo('screen-l2intro')">CONTINUE</button>
  </div>
</div>

<!-- LEVEL 2 RIZZ INTRO -->
<div class="screen" id="screen-l2intro" style="background:#1a0a2e;">
  <canvas id="bg2-canvas" style="position:absolute;top:0;left:0;width:100%;height:100%;"></canvas>
  <div style="position:relative;z-index:5;display:flex;align-items:center;justify-content:center;gap:40px;padding:30px;flex-wrap:wrap;">
    <canvas id="jawline-canvas" width="180" height="240" style="image-rendering:pixelated;image-rendering:crisp-edges;"></canvas>
    <div style="text-align:left;">
      <div style="font-family:'Press Start 2P',monospace;font-size:clamp(10px,2vw,16px);color:#FFD700;margin-bottom:24px;line-height:2.2;">OBJECTIVE 2:<br><br>RIZZ</div>
      <button class="pixel-btn" onclick="goTo('screen-hallway')" style="background:#ff00ff;border-color:#FFD700;">YES BRO</button>
    </div>
  </div>
</div>

<!-- HALLWAY -->
<div class="screen" id="screen-hallway" style="background:#1a1a2e;">
  <canvas id="hallway-canvas" style="position:absolute;top:0;left:0;width:100%;height:100%;"></canvas>
  <div style="position:absolute;top:10px;left:50%;transform:translateX(-50%);font-family:'Press Start 2P',monospace;font-size:7px;color:#ff88ff;background:rgba(0,0,0,0.8);padding:6px 14px;border:2px solid #ff88ff;z-index:10;white-space:nowrap;">SCHOOL HALLWAY &nbsp;|&nbsp; W/A/S/D = MOVE</div>
  <div id="rizz-btn-wrap" style="position:absolute;display:none;z-index:20;bottom:18%;left:50%;transform:translateX(-50%);">
    <button class="pixel-btn" onclick="doRizz()" style="background:#ff00ff;color:#fff;border-color:#FFD700;animation:pulse 0.5s infinite;">RIZZ UP 💅</button>
  </div>
</div>

<!-- RIZZ DIALOGUE -->
<div class="screen" id="screen-rizz-dialogue" style="background:#0a0a1a;">
  <div style="width:90%;max-width:620px;">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:18px;gap:10px;">
      <canvas id="player-sprite-rizz" width="90" height="130" style="image-rendering:pixelated;flex-shrink:0;"></canvas>
      <div style="flex:1;"></div>
      <canvas id="girls-sprite" width="130" height="130" style="image-rendering:pixelated;flex-shrink:0;"></canvas>
    </div>
    <div id="dialogue-box" style="font-family:'Press Start 2P',monospace;font-size:8px;color:#fff;background:#111;border:3px solid #FFD700;padding:14px;margin-bottom:14px;min-height:54px;line-height:2;">Girl: Heyyyy, I saw your buzzer beater! That was so aura.</div>
    <div id="choices-wrap" style="display:flex;flex-direction:column;gap:10px;">
      <button class="pixel-btn" onclick="rizzChoice('a')" style="font-size:7px;background:#0033cc;color:#fff;border-color:#88aaff;text-align:left;">[INNOCENT] Thanks, I really don't know how that went in!</button>
      <button class="pixel-btn" onclick="rizzChoice('b')" style="font-size:7px;background:#006622;color:#fff;border-color:#88ff88;text-align:left;">[NONCHALANT] Yup</button>
      <button class="pixel-btn" onclick="rizzChoice('c')" style="font-size:7px;background:#880000;color:#fff;border-color:#ff8888;text-align:left;">[EGO] Yeah I hit shots like that on the daily</button>
    </div>
    <div id="next-btn-wrap" style="display:none;text-align:center;margin-top:18px;">
      <button class="pixel-btn" onclick="goTo('screen-l3intro')">NEXT</button>
    </div>
  </div>
</div>

<!-- LEVEL 3 INTRO: GO VIRAL -->
<div class="screen" id="screen-l3intro" style="background:#0a1a0a;">
  <div style="text-align:center;">
    <div class="screen-title" style="font-size:clamp(11px,2.5vw,20px);margin-bottom:36px;">LEVEL 2:<br><br>GO VIRAL</div>
    <button class="pixel-btn" onclick="goTo('screen-fitcheck')" style="background:#00ffaa;color:#000;">YES BRO</button>
  </div>
</div>

<!-- FIT CHECK -->
<div class="screen" id="screen-fitcheck" style="background:#111122;">
  <div style="text-align:center;width:90%;max-width:480px;">
    <div style="font-family:'Press Start 2P',monospace;font-size:12px;color:#FFD700;margin-bottom:24px;">CHOOSE THE FIT</div>
    <div style="display:flex;align-items:center;justify-content:center;gap:20px;margin-bottom:16px;">
      <button class="pixel-btn" onclick="changeFit(-1)" style="font-size:16px;padding:12px 20px;">◀</button>
      <canvas id="fit-canvas" width="120" height="180" style="image-rendering:pixelated;border:3px solid #FFD700;"></canvas>
      <button class="pixel-btn" onclick="changeFit(1)" style="font-size:16px;padding:12px 20px;">▶</button>
    </div>
    <div id="fit-name" style="font-family:'Press Start 2P',monospace;font-size:7px;color:#ccc;margin-bottom:18px;min-height:22px;line-height:1.6;"></div>
    <div id="fit-next-btn" style="display:none;">
      <button class="pixel-btn" onclick="goTo('screen-viral')" style="background:#00ffaa;color:#000;">NEXT</button>
    </div>
  </div>
</div>

<!-- VIRAL PHONE -->
<div class="screen" id="screen-viral" style="background:#0a0a0a;">
  <canvas id="viral-canvas" style="position:absolute;top:0;left:0;width:100%;height:100%;"></canvas>
  <div style="position:absolute;bottom:12px;right:12px;font-family:'Press Start 2P',monospace;font-size:7px;color:#fff;background:rgba(0,0,0,0.85);padding:10px;border:2px solid #fff;z-index:10;line-height:2.2;">
    F = EMOTE &nbsp;|&nbsp; J = SAY<br>
    <span id="views-display" style="color:#ff4444;">VIEWS: 0</span>
  </div>
</div>

<!-- GONE VIRAL -->
<div class="screen" id="screen-gone-viral" style="background:#0a0a1a;">
  <canvas id="fireworks-canvas" style="position:absolute;top:0;left:0;width:100%;height:100%;"></canvas>
  <div style="position:relative;z-index:10;text-align:center;">
    <div class="screen-title" style="font-size:clamp(12px,3vw,24px);margin-bottom:24px;animation:pulse 0.7s infinite;">YOU'VE GONE VIRAL!</div>
    <canvas id="viral-char-canvas" width="120" height="160" style="image-rendering:pixelated;display:block;margin:0 auto 24px;"></canvas>
    <div id="viral-next-btn" style="display:none;">
      <button class="pixel-btn" onclick="goTo('screen-end')" style="background:#FFD700;color:#000;">NEXT</button>
    </div>
  </div>
</div>

<!-- END -->
<div class="screen" id="screen-end" style="background:#000;">
  <canvas id="end-canvas" style="position:absolute;top:0;left:0;width:100%;height:100%;"></canvas>
  <div style="position:relative;z-index:10;text-align:center;">
    <div style="font-family:'Press Start 2P',monospace;font-size:clamp(20px,5vw,48px);color:#FFD700;text-shadow:4px 4px 0 #ff6600;margin-bottom:20px;">THE END</div>
    <div style="font-family:'Press Start 2P',monospace;font-size:9px;color:#aaa;margin-top:10px;">Just wait for part 2</div>
    <div style="font-family:'Press Start 2P',monospace;font-size:8px;color:#555;margin-top:30px;">FINAL AURA: <span id="final-aura"></span></div>
  </div>
</div>

</div>

<script>
// ============ GLOBALS ============
let aura = 0;
let GS = {
  currentFit: 0, fitSelected: false,
  views: 0, controlsActive: false,
  bballKeys: {}, hallwayKeys: {},
  bballKD: null, bballKU: null,
  hallwayKD: null, hallwayKU: null,
  viralKD: null,
  bballTimer: null,
  rizzDone: false,
  fitAnimId: null,
};

const FITS = ['SUIT & TIE','FEAR OF GOD ATHLETICS\nOVERSIZED TEE','CLEAN BLUE\nATHLETIC TEE'];
const FIT_COLORS = [
  ['#1a1a1a','#333333','#660000'],
  ['#777777','#555555','#999999'],
  ['#1a55cc','#1144aa','#3377ee']
];

// ============ AURA ============
function updateAura(delta){
  aura += delta;
  document.getElementById('aura-val').textContent = aura;
  const fl = document.getElementById('aura-flash');
  fl.textContent = (delta>0?'+':'')+delta+' AURA';
  fl.style.color = delta>0 ? '#00ff88' : '#ff4444';
  fl.style.borderColor = delta>0 ? '#00ff88' : '#ff4444';
  fl.style.display = 'block';
  setTimeout(()=>fl.style.display='none', 2500);
}

// ============ SCREEN NAV ============
function goTo(id){
  document.querySelectorAll('.screen').forEach(s=>{s.style.display='none';s.classList.remove('active');});
  const t = document.getElementById(id);
  if(t){t.style.display='flex';t.classList.add('active');}

  // cleanup old key listeners
  if(id !== 'screen-basketball'){
    if(GS.bballKD){ document.removeEventListener('keydown',GS.bballKD); GS.bballKD=null; }
    if(GS.bballKU){ document.removeEventListener('keyup',GS.bballKU); GS.bballKU=null; }
    if(GS.bballTimer){ clearInterval(GS.bballTimer); GS.bballTimer=null; }
  }
  if(id !== 'screen-hallway'){
    if(GS.hallwayKD){ document.removeEventListener('keydown',GS.hallwayKD); GS.hallwayKD=null; }
    if(GS.hallwayKU){ document.removeEventListener('keyup',GS.hallwayKU); GS.hallwayKU=null; }
  }
  if(id !== 'screen-viral'){
    if(GS.viralKD){ document.removeEventListener('keydown',GS.viralKD); GS.viralKD=null; }
  }

  if(id==='screen-basketball') initBasketball();
  if(id==='screen-l2intro'){ drawBg2(); drawJawlineDude(); }
  if(id==='screen-hallway') initHallway();
  if(id==='screen-rizz-dialogue'){ GS.rizzDone=false; drawRizzSprites(); }
  if(id==='screen-fitcheck') initFitCheck();
  if(id==='screen-viral') initViral();
  if(id==='screen-gone-viral') initGoneViral();
  if(id==='screen-end'){ drawEndCanvas(); document.getElementById('final-aura').textContent=aura; }
}

function startGame(){ goTo('screen-l1intro'); }

// ============ HELPERS ============
function roundRect(ctx,x,y,w,h,r){
  ctx.beginPath();
  ctx.moveTo(x+r,y); ctx.lineTo(x+w-r,y);
  ctx.quadraticCurveTo(x+w,y,x+w,y+r);
  ctx.lineTo(x+w,y+h-r);
  ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);
  ctx.lineTo(x+r,y+h);
  ctx.quadraticCurveTo(x,y+h,x,y+h-r);
  ctx.lineTo(x,y+r);
  ctx.quadraticCurveTo(x,y,x+r,y);
  ctx.closePath();
}

function resizeCanvas(canvas){
  canvas.width = canvas.offsetWidth || window.innerWidth;
  canvas.height = canvas.offsetHeight || window.innerHeight;
}

// ============ DRAW HELPERS ============
function drawPixelPlayer(ctx, x, y, walkT, hasBall, fitIdx){
  const fc = fitIdx!=null ? FIT_COLORS[fitIdx] : ['#cc2200','#cc2200','#cc2200'];
  ctx.save();
  ctx.translate(Math.round(x)-12, Math.round(y)-30);
  // head
  ctx.fillStyle='#F4C17A'; ctx.fillRect(6,0,12,14);
  // eyes
  ctx.fillStyle='#000'; ctx.fillRect(8,4,3,3); ctx.fillRect(13,4,3,3);
  // body
  ctx.fillStyle=fc[0]; ctx.fillRect(3,14,18,20);
  // number on jersey
  ctx.fillStyle='#fff'; ctx.font='bold 7px monospace'; ctx.fillText('67',6,26);
  // shorts
  ctx.fillStyle=fc[1]; ctx.fillRect(3,33,18,12);
  // legs
  const lb = Math.sin(walkT)*4;
  ctx.fillStyle='#F4C17A';
  ctx.fillRect(3,44,7,14+lb); ctx.fillRect(14,44,7,14-lb);
  // shoes
  ctx.fillStyle='#fff';
  ctx.fillRect(1,56+lb,10,6); ctx.fillRect(12,56-lb,10,6);
  // arms
  ctx.fillStyle='#F4C17A';
  ctx.fillRect(-2,14,5,12); ctx.fillRect(21,14,5,12);
  ctx.restore();
}

function drawPixelDefender(ctx, x, y, walkT){
  ctx.save();
  ctx.translate(Math.round(x)-12, Math.round(y)-30);
  ctx.fillStyle='#F4A868'; ctx.fillRect(6,0,12,14);
  ctx.fillStyle='#000'; ctx.fillRect(8,4,3,3); ctx.fillRect(13,4,3,3);
  ctx.fillStyle='#ffffff'; ctx.fillRect(3,14,18,20);
  ctx.fillStyle='#dddddd'; ctx.fillRect(3,33,18,12);
  const lb=Math.sin(walkT+1)*3;
  ctx.fillStyle='#F4A868';
  ctx.fillRect(3,44,7,12+lb); ctx.fillRect(14,44,7,12-lb);
  ctx.fillStyle='#555';
  ctx.fillRect(1,55+lb,10,5); ctx.fillRect(12,55-lb,10,5);
  ctx.fillStyle='#F4A868';
  ctx.fillRect(-2,14,5,10); ctx.fillRect(21,14,5,10);
  // arms out (blocking)
  ctx.fillRect(-6,16,8,6); ctx.fillRect(22,16,8,6);
  ctx.restore();
}

function drawPixelBall(ctx, x, y, size=8){
  ctx.fillStyle='#ff7700';
  ctx.beginPath(); ctx.arc(x,y,size,0,Math.PI*2); ctx.fill();
  ctx.strokeStyle='#000'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(x-size,y); ctx.lineTo(x+size,y); ctx.stroke();
  ctx.beginPath(); ctx.arc(x,y,size,0,Math.PI); ctx.stroke();
  ctx.beginPath(); ctx.arc(x,y,size,Math.PI,Math.PI*2); ctx.stroke();
}

function drawVictoryDance(ctx, x, y, t){
  const sw = Math.sin(t*2.5)*18;
  ctx.save();
  ctx.translate(Math.round(x)-12, Math.round(y)-30);
  ctx.fillStyle='#F4C17A'; ctx.fillRect(6,0,12,14);
  ctx.fillStyle='#000'; ctx.fillRect(8,4,3,3); ctx.fillRect(13,4,3,3);
  // smile
  ctx.strokeStyle='#333'; ctx.lineWidth=1.5;
  ctx.beginPath(); ctx.arc(12,10,4,0.1,Math.PI-0.1); ctx.stroke();
  ctx.fillStyle='#cc2200'; ctx.fillRect(3,14,18,20);
  ctx.fillStyle='#fff'; ctx.font='bold 7px monospace'; ctx.fillText('67',6,26);
  ctx.fillStyle='#cc2200'; ctx.fillRect(3,33,18,12);
  ctx.fillStyle='#F4C17A'; ctx.fillRect(3,44,7,14); ctx.fillRect(14,44,7,14);
  ctx.fillStyle='#fff'; ctx.fillRect(1,56,10,6); ctx.fillRect(12,56,10,6);
  // 6-7 arms: hands open moving up and down
  ctx.fillStyle='#F4C17A';
  ctx.fillRect(-14, 14+sw, 16, 7); // left arm
  ctx.fillRect(20, 14-sw, 16, 7); // right arm
  // hands
  ctx.fillRect(-18, 12+sw, 8, 12);
  ctx.fillRect(34, 12-sw, 8, 12);
  ctx.restore();
}

function drawCourt(ctx, W, H){
  // floor
  ctx.fillStyle='#c9a96e'; ctx.fillRect(30,H*.1,W-60,H*.85);
  // lines
  ctx.strokeStyle='#fff'; ctx.lineWidth=2;
  ctx.strokeRect(30,H*.1,W-60,H*.85);
  ctx.beginPath(); ctx.moveTo(30,H*.52); ctx.lineTo(W-30,H*.52); ctx.stroke();
  ctx.beginPath(); ctx.arc(W/2,H*.52,42,0,Math.PI*2); ctx.stroke();
  ctx.strokeRect(W/2-55,H*.1,110,H*.19);
  ctx.strokeRect(W/2-32,H*.1,64,H*.14);
  ctx.beginPath(); ctx.arc(W/2,H*.29,60,Math.PI,Math.PI*2); ctx.stroke();
  ctx.strokeRect(W/2-55,H*.71,110,H*.24);
  ctx.strokeRect(W/2-32,H*.84,64,H*.1);
  ctx.beginPath(); ctx.arc(W/2,H*.71,60,0,Math.PI); ctx.stroke();
  // top hoop
  ctx.fillStyle='#ff6600'; ctx.fillRect(W/2-18,H*.13,36,5);
  ctx.fillStyle='#fff'; ctx.fillRect(W/2-32,H*.09,64,5);
  // stands
  ctx.fillStyle='#1c1c3c';
  ctx.fillRect(0,0,30,H); ctx.fillRect(W-30,0,30,H);
  ctx.fillRect(0,0,W,H*.09); ctx.fillRect(0,H*.96,W,H*.04);
}

function drawSpectators(ctx, W, H, t){
  const colors=['#ff4444','#4444ff','#ffaa00','#44ff88','#ff44ff','#44ffff','#ff8800','#8844ff'];
  for(let i=0;i<14;i++){
    const x = i<7 ? 2+i*24 : 2+(i-7)*24;
    const y = i<7 ? H*.01+Math.sin(t*.05+i)*5 : H*.96-14+Math.sin(t*.04+i)*4;
    ctx.fillStyle=colors[i%colors.length];
    ctx.fillRect(x,y+8,14,14);
    ctx.fillStyle='#F4C17A';
    ctx.fillRect(x+3,y,8,10);
    if(Math.sin(t*.08+i)>0.3){
      ctx.fillStyle=colors[i%colors.length];
